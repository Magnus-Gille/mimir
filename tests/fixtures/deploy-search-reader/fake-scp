#!/bin/bash
# Fake scp: strips a leading "host:" from operands and copies locally.
. "$FAKE_FIXTURES/fake-common.sh"
printf '%s\n' "$*" >>"$FAKE_LOG/scp.log"
operands=()
for a in "$@"; do
  case "$a" in -*) ;; *) operands+=("$a");; esac
done
n=${#operands[@]}
dest=${operands[$((n - 1))]}
if [ -n "${FAKE_SCP_FAIL_MATCH:-}" ] && case "$dest" in *"$FAKE_SCP_FAIL_MATCH"*) true;; *) false;; esac; then
  echo "scp: failure injected" >&2
  exit 1
fi
strip() { case "$1" in [A-Za-z0-9]*:/*) printf '%s' "${1#*:}";; *) printf '%s' "$1";; esac; }
dest=$(strip "$dest")
i=0
while [ "$i" -lt $((n - 1)) ]; do
  cp "$(strip "${operands[$i]}")" "$dest" || exit 1
  i=$((i + 1))
done
